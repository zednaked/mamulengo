#!/usr/bin/env python
# GDExtension do .boneco (o mesmo codigo do modulo, pelo godot-cpp): editor, jogo e CI com o
# Godot oficial. O jeito facil, o mesmo do CI, e o compilar.sh ao lado:
#   nucleo/godot/compilar.sh linux|windows|macos [template_debug|template_release]
# A mao:
#   scons -C nucleo/godot godot_cpp=<pasta> platform=linux target=template_debug disable_exceptions=no
#   scons -C nucleo/godot ... platform=windows use_mingw=yes disable_exceptions=no
#   scons -C nucleo/godot ... platform=macos arch=universal disable_exceptions=no
# godot_cpp: o argumento, ou a variavel de ambiente GODOT_CPP, ou nucleo/godot/godot-cpp (o
# compilar.sh clona ali no commit fixo).
# disable_exceptions=no: o leitor do nucleo usa excecao para o erro de leitura.
# Linux: compilar com o zig mirando o glibc 2.28 (o .so feito num Linux novo pede o glibc dele
# e nao abre no Ubuntu do CI nem em Linux antigos): os embrulhos de zig/ no PATH e
# use_llvm=yes (zig/zigcc.py explica). O godot-cpp tem de ser compilado com eles tambem: use uma
# pasta do godot-cpp so para isso, ou limpe a dele.
# Sai em nucleo/godot/bin/libboneco.<plataforma>.<alvo>.<arq>.<so|dll>; no macOS, um framework
# bin/libboneco.macos.<alvo>.framework (como o exemplo do godot-cpp).
import os

aqui = Dir(".").srcnode().abspath
opts = Variables([], ARGUMENTS)
padrao = os.environ.get("GODOT_CPP") or os.path.join(aqui, "godot-cpp")
opts.Add(PathVariable("godot_cpp", "pasta do godot-cpp", padrao, PathVariable.PathIsDir))
tmp = Environment(variables=opts)
godot_cpp = os.path.expanduser(tmp["godot_cpp"])
# o SConstruct do godot-cpp le os mesmos ARGUMENTS e reclama do que nao conhece
ARGUMENTS.pop("godot_cpp", None)
env = SConscript(os.path.join(godot_cpp, "SConstruct"))
env.Append(CPPPATH=["boneco", "../include"])
# um objeto por plataforma e alvo: trocar de um para o outro nao recompila tudo
env["SHOBJSUFFIX"] = env["suffix"] + env["SHOBJSUFFIX"]
if env["platform"] == "linux":
    # a biblioteca fica na memoria ate o fim do processo: com o zig, os destrutores estaticos
    # vao para o atexit e o Godot descarrega a extensao antes (segfault na saida)
    env.Append(LINKFLAGS=["-Wl,-z,nodelete"])
fontes = Glob("boneco/*.cpp") + [File(os.path.join("..", "src", f)) for f in sorted(os.listdir(os.path.join(aqui, "..", "src"))) if f.endswith(".cpp")]
if env["platform"] == "macos":
    nome = "libboneco.macos.{}".format(env["target"])
    lib = env.SharedLibrary("bin/{0}.framework/{0}".format(nome), source=fontes)
else:
    lib = env.SharedLibrary("bin/libboneco{}{}".format(env["suffix"], env["SHLIBSUFFIX"]), source=fontes)
Default(lib)
