[configuration]

entry_symbol = "boneco_library_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]

linux.debug.x86_64 = "res://addons/boneco/bin/libboneco.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/boneco/bin/libboneco.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://addons/boneco/bin/libboneco.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/boneco/bin/libboneco.windows.template_release.x86_64.dll"
macos.debug = "res://addons/boneco/bin/libboneco.macos.template_debug.framework"
macos.release = "res://addons/boneco/bin/libboneco.macos.template_release.framework"

[icons]

BonecoSprite = "res://addons/boneco/icon.svg"
BonecoData = "res://addons/boneco/icon.svg"
